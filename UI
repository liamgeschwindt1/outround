// ─── PRIMITIVES ─────────────────────────────────────────────────────────────

const Tag = ({ children, color = "default", dark }) => {
  const configs = {
    default: { bg: dark ? "rgba(255,255,255,0.05)" : "rgba(0,0,0,0.05)", border: dark ? T.border : T.borderL, color: dark ? T.t3 : T.t3L },
