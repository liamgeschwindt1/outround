);

const Label = ({ children, dark }) => (
  <div style={{
    fontFamily: T.body, fontSize: 9, fontWeight: 600,
    letterSpacing: "0.11em", textTransform: "uppercase",
    color: dark ? T.t4 : T.t4L, marginBottom: 10,
