    sky:     { bg: "rgba(61,159,212,0.08)", border: "rgba(61,159,212,0.18)", color: T.sky },
    green:   { bg: "rgba(22,163,74,0.08)", border: "rgba(22,163,74,0.18)", color: T.green },
    amber:   { bg: "rgba(217,119,6,0.08)", border: "rgba(217,119,6,0.18)", color: T.amber },
    red:     { bg: "rgba(220,38,38,0.08)", border: "rgba(220,38,38,0.18)", color: T.red },
  };
  const cfg = configs[color] || configs.default;
  return (
    <span style={{
      display: "inline-flex", alignItems: "center",
      padding: "2px 8px", borderRadius: R.pill,
      fontSize: 10, fontWeight: 500, letterSpacing: "0.03em",
      background: cfg.bg, border: `0.5px solid ${cfg.border}`,
      color: cfg.color, fontFamily: T.body,
    }}>{children}</span>
  );
};

const Mono = ({ children, color, size = 11, dark }) => (
  <span style={{ fontFamily: T.mono, fontSize: size, color: color || (dark ? T.t2 : T.t2L) }}>{children}</span>
);

